{
  "manifest_version": 3,
  "name": "CearchSpy — Etsy Keyword Research",
  "version": "1.0.0",
  "description": "Automate Etsy Alphabet Soup (A–Z suffix & prefix) keyword research, filter out irrelevant suggestions, and export to CSV.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.etsy.com/*",
    "https://*.etsy.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CearchSpy — Etsy Keyword Research",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/*",
        "https://*.etsy.com/*"
      ],
      "js": [
        "content/etsy-scanner.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
